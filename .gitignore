# ── 构建产物 / 大文件 ──
# GitHub 拒绝 >100MB 文件，且以下产物不应进入 git（由 CI / 本地构建生成）。
dist/
*.fpk
fnos-hermes-studio*.fpk
# bundled hermes-web-ui node_modules，本地构建时存在，不入库
app/node/
# Hermes Agent 离线源码包，构建时下载/准备，不入库
app/hermes-agent-src/
.hermes-agent.tar.gz
.ha-extract/
# Hermes Agent 的 browser tools + TUI 依赖（CI 打包生成，按相对路径镜像进 FPK），不入库
app/hermes-agent-node/
# 构建 agent node bundle 的临时工作目录
.agent-node-work/
app.tgz
manifest.checksum

# ── 依赖 / 缓存 ──
node_modules/
**/node_modules/

# ── 本地调试产物（含真实凭据的脚本一律不入库）──
scripts/fix_nas.py
scripts/test_*_nas.py
scripts/local_monitor.py
*.local.sh
.local/

# ── 系统 / 编辑器 ──
.DS_Store
Thumbs.db
*.log
.workbuddy/
